        const taskSig = fresh.tasks.reduce((acc, t) => {
          const ts = t.createdAt ? new Date(t.createdAt).getTime() : 0;
          return acc + ts;
        }, 0);
        const fingerprint = `${fresh.tasks.length}:${fresh.jobCounter}:${taskSig}`;
        if (fingerprint === stateVersionRef.current) return;
        stateVersionRef.current = fingerprint;
        setWorkspace(fresh);
