      try {
        // Guard 1: skip stale submissions (older than 10 minutes — likely orphaned or retried)
        const submissionAge = Date.now() - new Date(submission.submittedAt).getTime();
        if (submissionAge > 15 * 60 * 1000) {
          console.warn('[FormSubmission] Skipping stale submission (age:', Math.round(submissionAge / 1000), 's):', submission.id);
          try { await deleteFormSubmission(submission.id); } catch {}
          processingRef.current.delete(submission.id);
          return;
        }

        // Guard 2: prevent duplicate tasks when the same form is submitted twice within 15 min.
        // Uses a real Date.now() map so we're immune to task.createdAt being date-only strings.
        const normalizedTitle = (submission.task.title || '')
          .replace(/\{jobNumber\}/g, '').replace(/\s{2,}/g, ' ').trim().toLowerCase();
        const dedupeKey = `${submission.formId}:${normalizedTitle}`;
        const DEDUP_WINDOW = 15 * 60 * 1000; // 15 minutes
        const lastCreated = recentFormJobsRef.current.get(dedupeKey);
        if (lastCreated && (Date.now() - lastCreated) < DEDUP_WINDOW) {
          console.warn('[FormSubmission] Duplicate submission blocked — same form+title created', Math.round((Date.now() - lastCreated) / 1000), 's ago. Deleting submission', submission.id);
          try { await deleteFormSubmission(submission.id); } catch {}
