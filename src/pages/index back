            </div>

            {/* Drop zone — drag any task here to open it when no panel is shown */}
            {!isMobile && !selectedTask && isDraggingTask && !anyOverlayActive && (
              <div
                className="shrink-0 w-72 border-l-2 border-dashed border-primary/60 bg-primary/5 flex flex-col items-center justify-center gap-2 text-primary/70 text-sm font-medium transition-all"
                onDragOver={(e) => e.preventDefault()}
                onDrop={handleDropToOpenTask}
              >
                <span className="text-3xl">📋</span>
                <span>Drop here to open task</span>
              </div>
